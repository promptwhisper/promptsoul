# Non-secret defaults only. Never put a real API Key in this file or browser UI.
# Provide NPC_API_KEY only through the Node server environment.
NPC_API_BASE=https://api.openai.com/v1
# Replace this with a model your configured Provider actually supports.
NPC_MODEL=gpt-5.6-luna

# Local AivisSpeech TTS. All values stay on the Node server.
TTS_PROVIDER=aivis
AIVIS_BASE_URL=http://127.0.0.1:10101

# Prefer the UUID. Human-readable names are used for verification and fallback.
AIVIS_SPEAKER_UUID=5680ac39-43c9-487a-bc3e-018c0d29cc38
AIVIS_SPEAKER_NAME=コハク
AIVIS_STYLE_NAME=あまあま

# Optional. When set, this global Engine Style ID is still verified via /speakers.
AIVIS_STYLE_ID=

AIVIS_CONNECT_TIMEOUT_MS=3000
AIVIS_QUERY_TIMEOUT_MS=15000
AIVIS_SYNTHESIS_TIMEOUT_MS=60000

# Optional synthesis overrides. Empty values keep the Engine-generated defaults.
AIVIS_SPEED_SCALE=
AIVIS_INTONATION_SCALE=
AIVIS_TEMPO_DYNAMICS_SCALE=
AIVIS_VOLUME_SCALE=

TTS_MAX_TEXT_LENGTH=500
TTS_CACHE_ENABLED=true
TTS_CACHE_DIR=.cache/aivis-tts
TTS_CACHE_MAX_MB=256

# macOS only: explicitly opt in before scripts may try `open -a AivisSpeech`.
AIVIS_AUTOSTART=false
