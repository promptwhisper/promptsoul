{
  "name": "promptsoul",
  "version": "0.3.0",
  "private": true,
  "description": "Local-first AI Live2D NPC with safe prompt-to-motion generation",
  "license": "MIT",
  "keywords": [
    "live2d",
    "ai-npc",
    "aituber",
    "nextjs",
    "typescript",
    "self-hosted",
    "text-to-speech",
    "motion-generation"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 8765",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 8765",
    "check:repo": "tsx scripts/check-repository.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib scripts tests-node next.config.ts",
    "test": "node --import tsx --test tests-node/*.test.ts",
    "verify": "npm run check:repo && npm run typecheck && npm run lint && npm test && node --check assets/app.js && npm run build",
    "verify:browser": "tools/verify_browser.sh",
    "record:browser": "tools/record_browser.sh",
    "tts:check": "tsx scripts/tts-check.ts",
    "tts:smoke": "tsx scripts/tts-smoke.ts",
    "setup:demo": "tsx scripts/setup-demo.ts",
    "setup:model": "tsx scripts/setup-model.ts",
    "analyze:model": "tsx scripts/analyze-model.ts",
    "motions:generate": "tsx scripts/gen-motions.ts",
    "motions:validate": "tsx scripts/validate-motions.ts"
  },
  "dependencies": {
    "@aituber-onair/chat": "0.49.0",
    "@next/env": "16.2.12",
    "next": "16.2.12",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "minimatch": "10.2.6",
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "sharp@0.35.3": true,
    "unrs-resolver@1.12.2": true
  }
}
